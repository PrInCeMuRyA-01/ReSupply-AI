# Copy to backend/.env. All keys stay on the server.
# Existing working Sandbox keys can be reused; never copy an old database.
PAYPAL_SANDBOX_CLIENT_ID=PASTE_SANDBOX_CLIENT_ID_HERE
PAYPAL_SANDBOX_CLIENT_SECRET=PASTE_SANDBOX_CLIENT_SECRET_HERE

# OPTIONAL. Automatic restocking works without an LLM key.
# Enable only if you want sentences to fill product/sale forms via OpenAI.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
